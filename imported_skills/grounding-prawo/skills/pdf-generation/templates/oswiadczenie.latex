% naglowki markdown (#) w tresci oswiadczenia to podtytul, nie kolejny
% numerowany rozdzial — tytul "OSWIADCZENIE" juz jest wyzej
\usepackage{titlesec}
\setcounter{secnumdepth}{0}
\titleformat{\section}{\normalsize\itshape\centering}{}{0em}{}
\titlespacing*{\section}{0pt}{0.3\baselineskip}{0.8\baselineskip}

