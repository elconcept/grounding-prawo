{
  "_opis": "Rejestr serwerow za gateway. Dzieci to ISTNIEJACY {mcp}/gp-cache.mjs <serwer> (cache plikowy zgodny z lexcache, TTL, stale-fallback, cite-check) - gateway nie reimplementuje cache. proxy=true: ruch dziecka idzie przez rotator IP gatewaya (LEXCACHE_PROXY = lokalny proxy rotatora; hosty z GATEWAY_PROXY_HOSTS).",
  "servers": {
    "isap": {
      "command": "node",
      "args": [
        "{mcp}/gp-cache.mjs",
        "isap"
      ]
    },
    "saos": {
      "command": "node",
      "args": [
        "{mcp}/gp-cache.mjs",
        "saos"
      ],
      "proxy": true
    },
    "nsa": {
      "command": "node",
      "args": [
        "{mcp}/gp-cache.mjs",
        "nsa"
      ],
      "proxy": true
    },
    "krs": {
      "command": "node",
      "args": [
        "{mcp}/gp-cache.mjs",
        "krs"
      ]
    },
    "eu-sparql": {
      "command": "node",
      "args": [
        "{mcp}/gp-cache.mjs",
        "eu-sparql"
      ]
    },
    "eu-compliance": {
      "command": "node",
      "args": [
        "{mcp}/gp-cache.mjs",
        "eu-compliance"
      ]
    },
    "eureka": {
      "command": "node",
      "args": [
        "{mcp}/gp-cache.mjs",
        "eureka"
      ]
    },
    "repertorium": {
      "command": "node",
      "args": [
        "{mcp}/gp-cache.mjs",
        "repertorium",
        "--",
        "node",
        "{mcp}/servers/repertorium.mjs"
      ]
    },
    "api-rotator": {
      "command": "node",
      "args": [
        "/opt/api-rotator/index.js"
      ],
      "optional": true
    },
    "kio": {
      "command": "node",
      "args": [
        "{mcp}/gp-cache.mjs",
        "kio",
        "--",
        "kio-orzeczenia-mcp"
      ],
      "proxy": true,
      "optional": true
    }
  }
}