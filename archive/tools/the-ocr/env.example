# Copy to .env in this directory or configure the same names in the process environment.
DATALAB_API_KEY=
LLAMA_CLOUD_API_KEY=

# Optional independent regional credentials. Attempts follow EU, then US.
# DATALAB_API_KEY_EU=
# DATALAB_API_KEY_US=
# DATALAB_API_URL_EU=https://www.datalab.to
# DATALAB_API_URL_US=https://www.datalab.to
# LLAMA_CLOUD_API_KEY_EU=
# LLAMA_CLOUD_API_KEY_US=
# LLAMA_CLOUD_BASE_URL_EU=https://api.cloud.eu.llamaindex.ai
# LLAMA_CLOUD_BASE_URL_US=https://api.cloud.llamaindex.ai
# DATALAB_REGION_ORDER=eu,us
# LLAMA_CLOUD_REGION_ORDER=eu,us

# Optional regional/endpoint overrides:
# DATALAB_API_URL=https://www.datalab.to
# LLAMA_CLOUD_REGION=us
# LLAMA_CLOUD_BASE_URL=https://api.cloud.llamaindex.ai

# Fallback: Azure Document Intelligence (F0: 500 stron/mies.)
AZURE_DOCUMENT_ENDPOINT=
AZURE_DOCUMENT_KEY=
# albo zamiast klucza: nazwa zasobu, klucz pobierze `az` w locie
AZURE_DOCUMENT_RESOURCE=
AZURE_DOCUMENT_RESOURCE_GROUP=
AZURE_DOCUMENT_PAGES_PER_CALL=2

# Fallback: Google Cloud Vision (1000 jednostek/mies.); bez klucza - ADC z gcloud
GOOGLE_VISION_API_KEY=
GOOGLE_CLOUD_PROJECT=

# Kolejność łańcucha (domyślnie datalab,llamaparse,azure-di,google-vision)
THE_OCR_CHAIN=
