# the-ocr - zmienne srodowiska: zmienne procesu, potem pierwszy znaleziony plik .env:
# $THE_OCR_ENV_FILE, .env obok binarki (ze zrodel: w katalogu uruchomienia), ~/.config/the-ocr/.env
# (Windows: %APPDATA%\the-ocr\.env). Sciezki wzgledne licza sie od katalogu tego .env.
# W tym prywatnym repo prawdziwe klucze sa swiadomie w .env; ten plik to wzor bez sekretow.

# 1. Datalab (pierwszy w lancuchu)
DATALAB_API_KEY=
# DATALAB_API_KEY_EU= / DATALAB_API_KEY_US=   klucze regionalne
# DATALAB_REGION_ORDER=eu,us
# DATALAB_API_URL=

# 2. LlamaParse
LLAMA_CLOUD_API_KEY=
# LLAMA_CLOUD_API_KEY_EU= / LLAMA_CLOUD_API_KEY_US=
# LLAMA_CLOUD_REGION_ORDER=eu,us
# LLAMA_CLOUD_BASE_URL=https://api.cloud.llamaindex.ai

# 3. Azure Document Intelligence (prebuilt-read; F0: 500 stron/mies., 2 strony na zadanie)
AZURE_DOCUMENT_ENDPOINT=
AZURE_DOCUMENT_KEY=
# albo bez klucza, przez zalogowane `az`: AZURE_DOCUMENT_RESOURCE= (+ AZURE_DOCUMENT_RESOURCE_GROUP=)
# AZURE_DOCUMENT_PAGES_PER_REQUEST=2

# 4. Google Cloud Vision (1000 jednostek/mies.)
GOOGLE_VISION_API_KEY=
# albo konto uslugi: GOOGLE_VISION_CREDENTIALS=.secrets/gcloud-vision.json (sciezka wzgledem katalogu .env)
# albo ADC zalogowanego gcloud (`gcloud auth application-default login`), projekt rozliczeniowy:
# GOOGLE_CLOUD_PROJECT=moj-projekt

# 5. RapidOCR (lokalny, extra "local"; poza domyslnym lancuchem)
# THE_OCR_RAPIDOCR_DPI=200

# Kolejnosc lancucha (domyslnie datalab,llamaparse,azure,google_vision)
# THE_OCR_CHAIN=azure,google_vision,rapidocr
# Archiwum oryginalow dla --archive (domyslnie ~/archive)
# THE_OCR_ARCHIVE_DIR=
